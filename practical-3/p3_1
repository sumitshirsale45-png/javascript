<!DOCTYPE html>
<html>

<head>
    <title>Function Example</title>
</head>

<body>

    <h2>Simple JavaScript Function</h2>
    <button onclick="showGreeting()">Click Me</button>

    <p id="output"></p>

    <script>
        
        function greet(name) {
            return "Hello, " + name + "!";
        }

        function showGreeting() {
            let message = greet("Sumit");
            document.getElementById("output").innerHTML = message;
        }
    </script>

</body>

</html>
