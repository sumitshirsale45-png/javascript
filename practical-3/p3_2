<!DOCTYPE html>
<html>

<head>
    <title>Closure Example</title>
</head>

<body>

    <h2>JavaScript Closure Counter</h2>
    <button onclick="counter()">Click to Increase</button>

    <p id="countValue">Count: 0</p>

    <script>

        function outerFunction() {
            let count = 0;

            return function () {
                count++;
                document.getElementById("countValue").innerHTML = "Count: " + count;
            };
        }


        const counter = outerFunction();
    </script>

</body>

</html>
